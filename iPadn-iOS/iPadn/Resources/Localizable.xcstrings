    "当前安装的 iPadn 缺少图标资源，无法更换图标": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة iPadn المثبَّتة تفتقد موارد الأيقونات، لذا يتعذّر تغييرها"
          }
        }
      }
    },
    "当前设备不支持更换图标": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
