      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيقونة مسطّحة"
          }
        }
      }
    },
    "打开后可以浏览安装包内容、查看账号令牌和修改设备标识。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيله يمكنك تصفّح محتويات حزمة التثبيت وعرض رمز الحساب وتعديل معرّفات الجهاز."
          }
        }
      }
    },
    "接口地址，用 {id} 代表 App ID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان الواجهة، حيث يمثّل {id} معرّف التطبيق"
